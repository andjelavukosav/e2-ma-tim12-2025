<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Pozadina kartice -->
    <solid android:color="@android:color/white" />

    <!-- Ivica -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- Zaobljeni uglovi -->
    <corners android:radius="8dp" />

    <!-- Blaga senka (samo ako koristiš CardView ili Elevation u LinearLayout) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
