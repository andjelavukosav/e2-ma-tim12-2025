<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textLevelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Titula"
        android:textSize="20sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/textLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivo: 1"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/textPP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Snaga (PP): 0"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/textXP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XP: 0"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/textXPToNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XP do sledećeg nivoa: 200"
        android:textSize="18sp"
        android:paddingTop="8dp"/>

    <!-- Dugme za prelazak na Boss stranicu -->
    <Button
        android:id="@+id/btnGoToBoss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Idi na Boss stranicu"
        android:layout_marginTop="24dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</LinearLayout>
